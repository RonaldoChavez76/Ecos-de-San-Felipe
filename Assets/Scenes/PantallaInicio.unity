  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PantallaInicioManager
  cuatroImagenesHistoria:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  nombreEscenaNivel1: SampleScene
  musicaMenu: {fileID: 0}
  volumenMusica: 0.35
  sfxClick: {fileID: 0}
  dialogosIntro:
  - "1/4 \u2014 EL SILENCIO AL AMANECER:\nDurante la noche, una niebla desconocida cubri\xF3 las calles de cantera y adobe de San Felipe, Guanajuato..."
  - "2/4 \u2014 LOS ECOS DISPERSOS:\nLos recuerdos del pueblo se desprendieron en forma de cinco Ecos luminosos, dejando a sus habitantes sin memoria ni pasado."
  - "3/4 \u2014 LAS SOMBRAS CUSTODIAS:\nCriaturas nacidas de la oscuridad tomaron la Parroquia, el Mercado y el Mirador, confundiendo los Ecos con amenazas."
  - "4/4 \u2014 EL DEBER DE RONAN:\nArmado con su espada corta y el brazal capaz de devolver los ataques enemigos, Ronan debe recuperar los Ecos antes de que San Felipe se borre por completo."
  panelMenuInicio: {fileID: 210483386}
  panelControles: {fileID: 349822381}
  panelHistoriaCuatroImagenes: {fileID: 792457742}
  imgSlideActual: {fileID: 672118589}
