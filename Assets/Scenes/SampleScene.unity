  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1454273560}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 04fb0fd49c713254c8cf9cde21c3dddd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SanFelipeUIManager
  iniciarDirectoEnJuego: 1
  nombreEscenaMenuPrincipal: PantallaInicio
  cuatroImagenesHistoria:
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  - {fileID: 0}
  dialogosIntro:
  - "1/4 \u2014 EL SILENCIO AL AMANECER:\nDurante la noche, una niebla desconocida cubri\xF3 las calles de cantera y adobe de San Felipe, Guanajuato..."
  - "2/4 \u2014 LOS ECOS DISPERSOS:\nLos recuerdos del pueblo se desprendieron en forma de cinco Ecos luminosos, dejando a sus habitantes sin memoria ni pasado."
  - "3/4 \u2014 LAS SOMBRAS CUSTODIAS:\nCriaturas nacidas de la oscuridad tomaron la Parroquia, el Mercado y el Mirador, confundiendo los Ecos con amenazas."
  - "4/4 \u2014 EL DEBER DE RONAN:\nArmado con su espada corta y el brazal capaz de devolver los ataques enemigos, Ronan debe recuperar los Ecos antes de que San Felipe se borre por completo."
  dialogosPueblo:
  - "Anciano de la Plaza: \xAB\xA1Ronan! Qu\xE9 bueno que t\xFA a\xFAn recuerdas tu nombre... Las sombras se llevaron el Eco de la Fe hacia el callej\xF3n de La Parroquia.\xBB"
  - "Anciano de la Plaza: \xABRecuerda usar tu brazal con [K] o [Clic Derecho] justo antes de que sus proyectiles te impacten (0.20s) para devolv\xE9rselos con el doble de fuerza.\xBB"
  - "Anciano de la Plaza: \xABSi logras reunir suficiente energ\xEDa, desata el Modo Asalto con [L]. \xA1Devu\xE9lvele la memoria a San Felipe!\xBB"
  camaraLentaMuerte: 0.2
  duracionCamaraLenta: 1.6
