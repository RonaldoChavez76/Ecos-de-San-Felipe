  m_Script: {fileID: 11500000, guid: d12240a2e307401699d57144dcc1d302, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableSignOrNPC
  speakerName: "Capit\xE1n Rodrigo, Guardia del Atrio"
  interactionPrompt: "[E] Hablar con el Capit\xE1n Rodrigo"
  dialogueLines:
  - "\xA1Cuidado al subir las escaleras del Atrio, Ronan! Las criaturas de la Niebla atacan en hordas organizadas."
  - "En la segunda oleada aparecer\xE1 una Sombra Lanzadora: usa tu bloqueo [K] o [Clic Derecho] justo dentro de los primeros 0.20 segundos antes del impacto para devolverle sus orbes oscuros."
  - "Cuando derrotes a las dos oleadas del Atrio, el sello p\xFArpura de la puerta principal desaparecer\xE1 y podr\xE1s entrar al interior de la Parroquia."
  interactRadius: 2.1
  interactKey: 101
