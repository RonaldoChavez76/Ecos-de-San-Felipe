  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d12240a2e307401699d57144dcc1d302, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractableSignOrNPC
  speakerName: Don Anselmo, Cronista de San Felipe
  interactionPrompt: '[E] Hablar con Don Anselmo'
  dialogueLines:
  - "\xA1Bienvenido a la Gran Villa de San Felipe, Ronan! La Niebla del Olvido ha tomado los callejones exteriores y el Atrio de nuestra Parroquia."
  - "Aqu\xED en la Plaza de Armas est\xE1s a salvo. Camina hacia el Norte por la Calzada Real y sube la escalinata hacia el Gran Atrio de la Parroquia de San Felipe Ap\xF3stol."
  - Purifica las 2 oleadas de sombras que custodian el Atrio para abrir las puertas del templo, entra a la Parroquia y resuelve el Acertijo de las Tres Campanas de la Luz.
  interactRadius: 2.1
  interactKey: 101
